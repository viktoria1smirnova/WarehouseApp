<Window x:Class="WarehouseApp.Views.WhModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WhModWindow" Height="300" Width="450" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Наименование склада:" FontSize="14"/>
        <TextBox Grid.Row="1" Margin="0,8,0,0" Height="28" Text="{Binding WhName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Text="Адрес:" FontSize="14" Margin="0,16,0,0"/>
        <TextBox Grid.Row="3" Margin="0,8,0,0" Height="28" Text="{Binding WhAddress, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="DarkRed" FontSize="14" Text="{Binding ErrorText}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="90" Height="30" Margin="10,0,0,0" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>