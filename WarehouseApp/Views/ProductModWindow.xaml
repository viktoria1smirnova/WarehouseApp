<Window x:Class="WarehouseApp.Views.ProductModWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Редактирование товара" Height="650" Width="500" WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Артикул *" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Article}"/>

            <TextBlock Text="Наименование *" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Name}"/>

            <TextBlock Text="Единица" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Unit}"/>

            <TextBlock Text="Цена *" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Price}"/>

            <TextBlock Text="Скидка %" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Discount}"/>

            <TextBlock Text="Категория" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding CategoryName}"/>

            <TextBlock Text="Производитель" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding ManufacturerName}"/>

            <TextBlock Text="Поставщик" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding SupplierName}"/>

            <TextBlock Text="Путь к фото" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding PhotoPath}"/>

            <TextBlock Text="Описание товара" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Description}"/>

            <TextBlock Text="Количество *" FontWeight="Bold" Margin="0 0 0 3"/>
            <TextBox Height="28" Text="{Binding Quantity}" IsReadOnly="{Binding QuantityReadOnly}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
            <Button Content="Сохранить" Width="140" Height="40" FontWeight="Bold" Margin="0 0 10 0" Command="{Binding SaveCommand}"/>
            <Button Content="Отмена" Width="120" Height="40" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>