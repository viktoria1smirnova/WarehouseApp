<Window x:Class="WarehouseApp.Views.AddInvoiceItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавление товара в накладную" Height="300" Width="620"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" SelectionMode="Single" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Article}" FontWeight="Medium" Margin="2 0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>
                        <TextBlock Grid.Column="3" Text="{Binding StockQuantity, StringFormat=Ост: {0}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Количество:" VerticalAlignment="Center" Grid.Row="1" Margin="0 12 0 0"/>
            <TextBox Grid.Column="1" Margin="0 0 0 0" Height="26" Text="{Binding Quantity}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
            <Button Content="Добавить" Width="160" Height="38" FontWeight="Bold" Margin="0 0 10 0" Command="{Binding AddCommand}"/>
            <Button Content="Отмена" Width="120" Height="38" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>