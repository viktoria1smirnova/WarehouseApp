<Window x:Class="WarehouseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WarehouseApp"
        mc:Ignorable="d"
        Title="Управление складским хозяйством" Height="600" Width="1024" WindowStartupLocation="CenterScreen">

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#7FFF00">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="Накладные">
                <MenuItem Header="Создать входящую накладную" Command="{Binding AddIncomingInvoiceCommand}"/>
                <MenuItem Header="Создать исходящую накладную" Command="{Binding AddOutgoingInvoiceCommand}"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <TextBlock FontFamily="Verdana" FontSize="14" Margin="10" FontWeight="Bold"/>
        </StatusBar>

        <Frame DockPanel.Dock="Right" NavigationUIVisibility="Hidden" Background="White" Content="{Binding CurrentPage}"/>
    </DockPanel>
</Window>